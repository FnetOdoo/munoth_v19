<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="voucher_comp_rule" model="ir.rule">
            <field name="name">Voucher multi-company</field>
            <field name="model_id" ref="model_account_voucher"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        </record>

        <record id="voucher_line_comp_rule" model="ir.rule">
            <field name="name">Voucher Line multi-company</field>
            <field name="model_id" ref="model_account_voucher_line"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
        </record>

        <!-- Create a privilege for Journal Voucher access groups -->
        <record id="res_groups_privilege_journal_voucher" model="res.groups.privilege">
            <field name="name">Journal Voucher</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_cash_payment_access" model="res.groups">
            <field name="name">Cash Payment Access</field>
            <field name="privilege_id" ref="res_groups_privilege_journal_voucher"/>
        </record>

        <record id="group_currencies_access" model="res.groups">
            <field name="name">Currencies Access</field>
            <field name="privilege_id" ref="res_groups_privilege_journal_voucher"/>
            <field name="implied_ids" eval="[(4, ref('journal_voucher.group_cash_payment_access'))]"/>
        </record>

    </data>
</odoo>
