<?xml version="1.0" encoding="utf-8"?>
<!-- Maintenance stages used by maintenance_extended. The code identifies them by these XML ids
     (see STAGE_* in models/models.py); there are no Draft/Progress/Done/Cancel flags on the stage. -->
<odoo>
    <data noupdate="1">
        <record id="maintenance.stage_0" model="maintenance.stage">
            <field name="name">New Request</field>
            <field name="sequence">1</field>
            <field name="done" eval="False"/>
            <field name="fold" eval="False"/>
        </record>
        <record id="maintenance.stage_1" model="maintenance.stage">
            <field name="name">In Progress</field>
            <field name="sequence">2</field>
            <field name="done" eval="False"/>
            <field name="fold" eval="False"/>
        </record>
        <record id="maintenance.stage_3" model="maintenance.stage">
            <field name="name">Calibration Done</field>
            <field name="sequence">3</field>
            <field name="done" eval="True"/>
            <field name="fold" eval="False"/>
        </record>
        <record id="maintenance.stage_4" model="maintenance.stage">
            <field name="name">Cancel</field>
            <field name="sequence">4</field>
            <field name="done" eval="False"/>
            <field name="fold" eval="True"/>
        </record>
    </data>
</odoo>
