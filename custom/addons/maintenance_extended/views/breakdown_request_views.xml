<odoo>
    <record id="view_breakdown_request_form" model="ir.ui.view">
        <field name="name">breakdown.request.form</field>
        <field name="model">breakdown.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Request: only in draft AND only for the requester -->
                    <button name="action_request" string="Breakdown Request" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <!-- Complete: only maintenance user, in request state -->
                    <button name="action_done" string="Breakdown Complete" type="object"
                            class="btn-success"
                            invisible="state != 'request'"
                            groups="maintenance.group_equipment_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,request,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" nolabel="1" readonly="1"/>
                        </h1>
                    </div>
                    <field name="company_id" invisible="1"/>

                    <!-- Draft info: required in draft, locked after requesting -->
                    <group>
                        <group>
                            <field name="machine_id" required="state == 'draft'"
                                   readonly="state != 'draft'"/>
                            <field name="shift_id" required="state == 'draft'"
                                   readonly="state != 'draft'"/>
                            <field name="problem_category" readonly="1"/>
                            <field name="engineer_name" readonly="state != 'draft'" required="state == 'draft'"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority" readonly="state != 'draft'"
                                   required="state == 'draft'"/>
                            <field name="requested_user_id" readonly="state != 'draft'" required="state == 'draft'"/>
                            <field name="requested_time" readonly="state != 'draft'" required="state == 'draft'"/>
                            <field name="operated_by" readonly="state != 'draft'" required="state == 'draft'"/>
                        </group>
                    </group>
                    <separator string="Problem Description"/>
                    <field name="problem_description" nolabel="1" colspan="2"
                           required="state == 'draft'"
                           placeholder="Enter Problem Description here..." readonly="state != 'draft'"/>
                    <notebook>
                        <page string="Maintenance User" name="material">
                            <group>
                                <group>
                                    <field name="attended_by" required="state == 'request'"
                                           readonly="state != 'request'"/>
                                    <field name="root_cause" required="state == 'request'"
                                           readonly="state != 'request'"/>
                                    <field name="corrective" required="state == 'request'"
                                           readonly="state != 'request'"/>

                                </group>
                                <group>
                                    <field name="solution_permanent"
                                           widget="receipt_selector"
                                           options="{'horizontal': true}" readonly="state != 'request'"/>
                                    <field name="start_date" required="state == 'request'"
                                           readonly="state != 'request'"/>
                                    <field name="end_date" required="state == 'request'" readonly="state != 'request'"/>
                                    <field name="duration_display" readonly="1"/>
                                </group>
                            </group>

                            <separator string="Remarks"/>
                            <field name="remarks" nolabel="1" colspan="2"
                                   required="state == 'request'"
                                   placeholder="Enter remarks here..." readonly="state != 'request'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_breakdown_request_tree" model="ir.ui.view">
        <field name="name">breakdown.request.tree</field>
        <field name="model">breakdown.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="machine_id"/>
                <field name="problem_description"/>
                <field name="priority" widget="priority" readonly="1"/>
                <field name="requested_user_id"/>
                <field name="requested_time"/>
                <field name="shift_id"/>
                <field name="duration_display"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'request'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="action_breakdown_request" model="ir.actions.act_window">
        <field name="name">Breakdown Requests</field>
        <field name="res_model">breakdown.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_breakdown_request': True}</field>
        <field name="domain">[('is_breakdown_request', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'sequence': 1, 'view_id': ref('view_breakdown_request_tree')}),
        (0, 0, {'view_mode': 'form', 'sequence': 2, 'view_id': ref('view_breakdown_request_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new breakdown request
            </p>
            <p>
                Follow the process of the request and communicate with the collaborator.
            </p>
        </field>
    </record>
    <menuitem id="menu_bd_requests" name="Breakdown Requests" parent="maintenance.menu_m_request_form"
              action="action_breakdown_request" sequence="2"/>
</odoo>