<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_user_manual_form" model="ir.ui.view">
        <field name="name">user.manual.form</field>
        <field name="model">user.manual</field>
        <field name="arch" type="xml">
            <form string="User Manual">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fullscreen"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-expand"
                                invisible="not manual_file">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Full Screen</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Installation Guide"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="manual_file"
                                   filename="manual_filename"
                                   string="Upload Manual"/>
                            <field name="manual_filename" invisible="1"/>
                            <field name="is_pdf" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <separator string="Description"/>
                    <field name="description" nolabel="1"
                           placeholder="Optional notes about this manual..."/>

                    <div class="alert alert-info" role="alert"
                         invisible="manual_file">
                        Allowed file types: PDF, DOC, DOCX, ODT, RTF, TXT.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_user_manual_list" model="ir.ui.view">
        <field name="name">user.manual.list</field>
        <field name="model">user.manual</field>
        <field name="arch" type="xml">
            <list string="User Manuals">
                <field name="name"/>
                <field name="manual_filename"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_user_manual_search" model="ir.ui.view">
        <field name="name">user.manual.search</field>
        <field name="model">user.manual</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_user_manual" model="ir.actions.act_window">
        <field name="name">User Manuals</field>
        <field name="res_model">user.manual</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_user_manual_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first user manual
            </p>
            <p>
                Only PDF and document files are allowed.
            </p>
        </field>
    </record>

    <menuitem id="menu_user_manual_root"
              name="User Manuals"
              sequence="50" web_icon="user_manual,static/icon.png"/>
    <menuitem id="menu_user_manual_main"
              name="Manuals"
              parent="menu_user_manual_root"
              action="action_user_manual"
              sequence="10"/>

</odoo>
